.globl octal_convert

.text

octal_convert:
    li $v0, 0   # result

decode_loop:
    # get and check for \0
    lb $t0, 0($a0)
    beq $t0, $zero, done

    # validate
    blt $t0, '0', error
    bgt $t0, '7', error

    addi $t0, $t0, -48   # subtract ASCII of '0'  

    # multiply by 8 (shift left 3 places) 
    sll $v0, $v0, 3

    add $v0, $v0, $t0    # add octal digit to the result

    addi $a0, $a0, 1     # go to next input char
    j decode_loop

error:
    li $v0, -1

done:
    jr $ra

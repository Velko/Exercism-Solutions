.globl hex_convert

.text

hex_convert:
    li $v0, 0   # result

decode_loop:
    # get and check for \0
    lb $t0, 0($a0)
    beq $t0, $zero, done

    # validate 0-9
    blt $t0, '0', try_af
    bgt $t0, '9', try_af

    addi $t0, $t0, -48   # subtract ASCII of '0'  
    j add_digit

try_af:
    andi $t0, $t0, 0xDF  # convert to uppercase

    # validate A-F
    blt $t0, 'A', error
    bgt $t0, 'F', error
    
    addi $t0, $t0, -55   # subtract ASCII of 'A' and add 10

add_digit:
    # multiply by 16 (shift left 4 places) 
    sll $v0, $v0, 4

    add $v0, $v0, $t0    # add hex digit to the result

    addi $a0, $a0, 1     # go to next input char
    j decode_loop

error:
    li $v0, -1

done:
    jr $ra

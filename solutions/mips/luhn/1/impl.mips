.globl valid

# Instead of trying to loop in reverse and double every second digit,
# calculate the checksum in forward loop, for both odd and even
# digits seperately. Swap the checksums between 2 registers. When
# the loop ends, the checksum should always be in the register that
# last received an unchanged digit

valid:
    li $v0, 0        # default result = False, until calculated
    li $t1, 0        # accumulate and swap checksum 
    li $t2, 0        # between these registers
    li $t4, 0        # valid digit count

loop:
    lb $t0, 0($a0)
    beqz $t0, check        # end-of-string, proceed to check
    beq $t0, ' ', next     # space, skip
    blt $t0, '0', done     # invalid character
    bgt $t0, '9', done     # invalid character

    addi $t0, $t0, -48     # subtract ASCII of '0', converting into number
    add $t3, $t0, $t0      # double into $t3
    ble $t3, 9, keep_9
    addi $t3, $t3, -9      # adjust if was > 9
keep_9:

    # swap $t1 and $t2, add adjusted double to one,
    # original to another. When loop ends, $t2 will always
    # contain the needed checksum
    add $t3, $t3, $t2
    add $t2, $t1, $t0
    move $t1, $t3

    addi $t4, $t4, 1    # count valid digits

next:
    addi $a0, $a0, 1
    j loop

check:
    # is length > 1
    ble $t4, 1, done

    # reminder == 0
    li $t0, 10
    div $t2, $t0
    mfhi $t0
    slti $v0, $t0, 1

done:
    jr $ra
.globl nucleotide_counts

nucleotide_counts:
    # initialize counters
    move $t2, $zero
    move $t3, $zero
    move $t4, $zero
    move $t5, $zero

decode_loop:
    lb $t0, 0($a0)       # get char
    beq $t0, $zero, done # exit if \0 char

    # check for each nucleotide, increment appropriate counter
check_a:
    bne $t0, 'A', check_c
    addi $t2, $t2, 1
    j next

check_c:
    bne $t0, 'C', check_g
    addi $t3, $t3, 1
    j next

check_g:
    bne $t0, 'G', check_t
    addi $t4, $t4, 1
    j next

check_t:
    bne $t0, 'T', error
    addi $t5, $t5, 1
    j next

error:
    # unknown char detected
    li $t2, -1
    li $t3, -1
    li $t4, -1
    li $t5, -1

    j done

next:
    addi $a0, $a0, 1
    j decode_loop

done:
    # store results
    sw $t2, 0($a1)
    sw $t3, 4($a1)
    sw $t4, 8($a1)
    sw $t5, 12($a1)

    jr $ra
.globl is_isogram

.data

counters: .byte 0:26

.text

is_isogram:
    # zero out the counters array
    # (values from previous run)
    li $t0, 0
clear_loop:
    sb $zero, counters($t0)
    addi $t0, $t0, 1
    blt $t0, 26, clear_loop
    

    # True result by default
    li $v0, 1

scan_loop:
    # load and check for \0
    lb $t0, 0($a0)
    beq $t0, $zero, done

    # case insensitive A-Z detection
    andi $t0, $t0, 0xDF
    blt $t0, 'A', next
    bgt $t0, 'Z', next

    # convert letter to index in array
    addi $t0, $t0, -65 # subtract ASCII of 'A'

    # load previous value
    lb $t1, counters($t0)

    # if there's already 1 it is not an isogram,
    # the letter was encountered before
    bge $t1, 1, non_iso

    # increment and store
    addi $t1, $t1, 1
    sb $t1, counters($t0)

next:
    addi $a0, $a0, 1
    j scan_loop
    

non_iso:
    # set to False as non-isogram was detected
    li $v0, 0


done:
    jr $ra
